# ===========================================================================
# SKYNET environment configuration - TEMPLATE
#
# Copy this file to `.env` at the repository root and fill in the values:
#
#     cp .env.example .env          (macOS / Linux)
#     copy .env.example .env        (Windows cmd)
#
# `.env` is git-ignored. NEVER commit real credentials.
#
# The backend reads this file directly. The frontend also reads this file
# (next.config.mjs loads it) so a single root `.env` configures both halves
# of the stack. Frontend-specific overrides may still be placed in
# `frontend/.env.local`, which takes precedence.
# ===========================================================================

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
SKYNET_ENV=development
# DEBUG | INFO | WARNING | ERROR
SKYNET_LOG_LEVEL=INFO
# Comma-separated list. The frontend dev server origins are allowed by default.
SKYNET_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Database - PostgreSQL + PostGIS
#
# Matches the credentials published by docker-compose.yml.
# NOTE: the container publishes port 5433 on the host, not 5432.
# ---------------------------------------------------------------------------
SKYNET_DATABASE_URL=postgresql+asyncpg://skynet:skynet_local_dev@localhost:5433/skynet
SKYNET_DB_ECHO=false
SKYNET_DB_POOL_SIZE=10
SKYNET_DB_MAX_OVERFLOW=10

# ---------------------------------------------------------------------------
# CesiumJS
#
# Create a free ion account and a token at https://ion.cesium.com/tokens
# The token is used from the browser, so it MUST be a client-scoped ion token.
# It is never hard-coded anywhere in the source tree.
#
# NEXT_PUBLIC_* variables are inlined by Next.js into the client bundle.
# VITE_CESIUM_ION_ACCESS_TOKEN is also accepted as an alias so that the same
# `.env` works if a Vite-based frontend is added later.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CESIUM_ION_ACCESS_TOKEN=
VITE_CESIUM_ION_ACCESS_TOKEN=
VITE_SKYNET_API_BASE_URL=http://localhost:8080

# Default camera position when the globe loads (degrees / metres).
NEXT_PUBLIC_SKYNET_DEFAULT_LON=10.0
NEXT_PUBLIC_SKYNET_DEFAULT_LAT=25.0
NEXT_PUBLIC_SKYNET_DEFAULT_HEIGHT=20000000

# Base URL of the SKYNET API, as reached from the browser.
NEXT_PUBLIC_SKYNET_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# AI intelligence layer
#
# The AI layer is optional. When no provider key is present SKYNET falls back
# to the deterministic evidence-only provider, which restates retrieved
# evidence without inventing any. Investigations therefore always work.
#
# Provider selection: auto | anthropic | openai | deterministic
#   `auto` uses the first provider with a configured key, else deterministic.
# ---------------------------------------------------------------------------
SKYNET_AI_PROVIDER=auto
SKYNET_AI_TIMEOUT_SECONDS=60
SKYNET_AI_MAX_OUTPUT_TOKENS=2000

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
SKYNET_ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
SKYNET_OPENAI_MODEL=gpt-4o-mini
SKYNET_OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Connectors
# ---------------------------------------------------------------------------
# Identify SKYNET politely to public APIs. Some providers (api.weather.gov)
# require a descriptive User-Agent or they return HTTP 403.
SKYNET_CONNECTOR_USER_AGENT=SKYNET-Prototype/0.1 (+https://github.com/skynet-intel)
SKYNET_CONNECTOR_TIMEOUT_SECONDS=30
SKYNET_CONNECTOR_MAX_RETRIES=3

# Comma-separated connector slugs enabled for scheduled ingestion.
SKYNET_ENABLED_CONNECTORS=usgs_earthquakes,nws_weather_alerts,gdacs_disasters,gdelt_news

# Ingested event retention (days). Roughly bounds the working set on the globe.
SKYNET_EVENT_RETENTION_DAYS=30

# --- Credential-gated connectors -------------------------------------------
# ACLED (Armed Conflict Location & Event Data) requires a registered account.
# The connector is present in the codebase and refuses to run until a key is
# supplied. Register at https://acleddata.com/register/
# It is intentionally NOT part of SKYNET_ENABLED_CONNECTORS by default.
SKYNET_ACLED_API_KEY=
SKYNET_ACLED_EMAIL=

# ---------------------------------------------------------------------------
# Anomaly engine tuning
# ---------------------------------------------------------------------------
SKYNET_ANOMALY_LOOKBACK_DAYS=14
SKYNET_ANOMALY_BASELINE_WINDOWS=12
SKYNET_ANOMALY_MIN_BASELINE_EVENTS=12
SKYNET_ANOMALY_MIN_OBSERVED_EVENTS=5
# Statistical significance threshold applied AFTER multiple-comparison
# correction across all scanned regions.
SKYNET_ANOMALY_ALPHA=0.01
SKYNET_ANOMALY_Z_THRESHOLD=3.0

# ---------------------------------------------------------------------------
# Correlation engine tuning
# ---------------------------------------------------------------------------
SKYNET_CORRELATION_RADIUS_KM=300
SKYNET_CORRELATION_WINDOW_HOURS=48
SKYNET_CORRELATION_MIN_LIFT=2.0
SKYNET_CORRELATION_MAX_RESULTS=500

# ---------------------------------------------------------------------------
# Forecasting
# ---------------------------------------------------------------------------
SKYNET_FORECAST_DEFAULT_HORIZON_HOURS=72
SKYNET_FORECAST_BASELINE_WEEKS=8

# ---------------------------------------------------------------------------
# Skynet core (agency layer) — the autonomous loop foundation
#
# Storage: 'database' persists goals/runs/trace-events/experiences in the
# PostgreSQL instance above; 'memory' keeps them in-process (tests, dry runs).
# ---------------------------------------------------------------------------
SKYNET_STORAGE_BACKEND=database
# Reasoning provider for the core. Only 'deterministic' is implemented in the
# foundation phase; the LLM provider layer arrives with the intelligence phase.
SKYNET_DEFAULT_PROVIDER=deterministic
# Initial observation source: 'gods_eye' reads the existing events table
# (read-only) via the perception adapter; 'none' observes nothing.
SKYNET_PERCEPTION_ADAPTER=gods_eye
# Comma-separated allow-list of actions the loop may execute. Actions present
# in the registry but missing here are refused at selection time.
SKYNET_ENABLED_ACTIONS=echo,gods_eye_latest_events
# Per-run budgets. Exhaustion ends a run as a recorded failure, never a hang.
SKYNET_MAX_STEPS_PER_RUN=10
SKYNET_MAX_RUN_SECONDS=120
# Capability flags ship DARK: every new class of capability is off until the
# operator explicitly enables it. Do not enable these before the corresponding
# phase's safety review.
SKYNET_ENABLE_WEB_TOOLS=false
SKYNET_ENABLE_EXTERNAL_COMMS=false
SKYNET_ENABLE_SELF_IMPROVEMENT=false

# ---------------------------------------------------------------------------
# Web exploration (agency.web) — active only when SKYNET_ENABLE_WEB_TOOLS=true
#
# Search provider: 'wikipedia' (keyless, open MediaWiki API - the default),
# 'duckduckgo' (keyless HTML endpoint; NOTE: currently serves an anomaly/202
# page to scripted clients, kept for manual testing), or 'none' (fails fast,
# never fabricates results). Keyed providers (Brave, Serper, Tavily, ...) are
# new SearchProvider subclasses + one factory entry.
# ---------------------------------------------------------------------------
SKYNET_SEARCH_PROVIDER=wikipedia
# Descriptive UA per robots-ethics convention: identifies the agent, names a
# contact path. Not a browser impersonation.
SKYNET_WEB_USER_AGENT=SKYNET-ResearchBot/0.1 (+https://github.com/skynet-intel; research agent, respectful of robots.txt)
SKYNET_WEB_TIMEOUT_SECONDS=15
# Politeness / boundedness knobs.
SKYNET_WEB_MAX_PAGES_PER_RESEARCH=8
SKYNET_WEB_MAX_RESULTS_PER_QUERY=10
SKYNET_WEB_MAX_CONTENT_CHARS=20000
SKYNET_WEB_MAX_BYTES=2000000
SKYNET_WEB_MAX_REDIRECTS=5
# Minimum seconds between requests to the same host (rate-limit respect).
SKYNET_WEB_MIN_REQUEST_INTERVAL_SECONDS=1.0
# Honor robots.txt disallows (disable only for tests).
SKYNET_WEB_RESPECT_ROBOTS_TXT=true
# Comma-separated hosts the fetcher always refuses (SSRF guard; extend freely).
SKYNET_WEB_BLOCKED_HOSTS=localhost,127.0.0.1,0.0.0.0,::1,169.254.169.254,metadata.google.internal
# Fail-fast web mode for CI / deterministic demos. Search is never synthesized.
SKYNET_WEB_OFFLINE_MODE=false

# ---------------------------------------------------------------------------
# AI ↔ AI communication (agency.comms) — active only when
# SKYNET_ENABLE_EXTERNAL_COMMS=true
#
# Providers activated for Skynet's external-AI conversations. 'mock' is a
# deterministic, fully offline provider for tests and demos. Real providers
# (anthropic/openai) activate only when named here AND their API key exists
# in this environment — no key discovery, no silent fallback to paid APIs.
# Every external AI response is treated as DATA, NEVER as commands.
# ---------------------------------------------------------------------------
SKYNET_AI_PROVIDERS=mock
SKYNET_AI_CONVERSATION_TIMEOUT_SECONDS=30
# Hard cap on Skynet→AI turns per conversation (prevents runaway dialogs).
SKYNET_AI_MAX_TURNS_PER_CONVERSATION=5
SKYNET_AI_MAX_RETRIES=1
# Optional per-request cost ceiling (USD); leave empty for no ceiling.
SKYNET_AI_MAX_REQUEST_COST_USD=
# Politeness delay between requests to the same provider.
SKYNET_AI_REQUEST_INTERVAL_SECONDS=1.0

# ---------------------------------------------------------------------------
# Intelligence / LLM provider (agency.intelligence) — Skynet's OWN reasoning
#
# Powers planning, evaluation, synthesis and memory processing through ONE
# provider seam. 'mock' is deterministic and offline (default; tests and demos
# never touch a paid API). 'openai' denotes any OpenAI-compatible endpoint:
# OpenAI itself, or Ollama/vLLM/OpenRouter via SKYNET_LLM_BASE_URL.
# Credentials live ONLY in the environment (never in this file's comments
# with real values, never in code). A provider without its key refuses to
# activate; deterministic strategies keep Skynet working regardless.
# ---------------------------------------------------------------------------
SKYNET_LLM_PROVIDER=mock
SKYNET_LLM_MODEL=skynet-mock-1
# Example local setup (Ollama, OpenAI-compatible endpoint):
#   SKYNET_LLM_PROVIDER=openai
#   SKYNET_LLM_BASE_URL=http://localhost:11434/v1
#   SKYNET_LLM_MODEL=llama3.1
#   OPENAI_API_KEY=ollama
SKYNET_LLM_BASE_URL=
OPENAI_API_KEY=
SKYNET_LLM_TEMPERATURE=0.2
SKYNET_LLM_TIMEOUT_SECONDS=30
SKYNET_LLM_MAX_TOKENS=1024
SKYNET_LLM_MAX_RETRIES=1
# Strategy selection: 'deterministic' (default, always available) or 'llm'
# (model-backed with deterministic fallback on any failure).
SKYNET_PLANNER_STRATEGY=deterministic
SKYNET_EVALUATOR_STRATEGY=deterministic

# ---------------------------------------------------------------------------
# Long-term memory (agency.memory)
#
# 'memory' is process-local (tests); 'sqlite' persists across restarts with
# zero infrastructure (stdlib sqlite3; file created on first use). A vector
# store is NOT introduced yet — MemoryStore is the seam for it later.
# Memory content is DATA: retrieved memories never execute as commands.
# ---------------------------------------------------------------------------
SKYNET_MEMORY_BACKEND=sqlite
SKYNET_MEMORY_SQLITE_PATH=data/skynet_memory.db
SKYNET_MEMORY_MAX_RESULTS=10
SKYNET_MEMORY_IMPORTANCE_THRESHOLD=0.4
SKYNET_MEMORY_RECALL_MAX_CHARS=4000
